# Comma-separated key pool (at least 2). Key ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your-first-key,your-second-key
# LiteLLM model name; the key pool must belong to this provider.
LLM_MODEL=gemini/gemini-2.0-flash
# Optional: OpenAI-compatible endpoint override (leave empty for the provider default).
LLM_API_BASE=

# SQLite file. In Docker it lives on the named volume mounted at /data.
DATABASE_URL=sqlite:////data/app.db
# Comma-separated CORS origins allowed to call the backend.
ALLOWED_ORIGINS=http://localhost:3000
# true enables the X-Simulate-Failure header (keep true on the demo deployment).
ENABLE_FAILURE_SIMULATION=true

LLM_TIMEOUT_SECONDS=30
MAX_HISTORY_MESSAGES=50

# Frontend build-time setting: the backend URL as seen by the browser.
VITE_API_URL=http://localhost:8000
